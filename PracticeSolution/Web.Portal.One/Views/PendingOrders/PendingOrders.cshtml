@model IEnumerable<Web.Portal.One.Domain.SPendingOrders>

@{
	ViewData["Title"] = "Pending Orders";
	Layout = "~/Pages/Shared/_Layout.cshtml";
}


<table class="table">
	<thead>
		<tr>
			<th>
				<span>Make</span>
			</th>
			<th>
				<span>Company</span>
			</th>
			<th>
				@Html.DisplayNameFor(model => model.ScheduledDate)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.SentDate)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Price)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Quantity)
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Make.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Company.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.ScheduledDate)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.SentDate)
				</td>
				<td>
					$ @Html.DisplayFor(modelItem => item.Price)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Quantity)
				</td>
			</tr>
		}
	</tbody>
</table>
